# copy to .env and adjust
DOWNLOAD_BASE_DIR=downloads
STATE_DB_PATH=data/state.db
MIN_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO

# Optional: pass cookies or a logged-in browser profile to yt-dlp to reduce rate limits
# TIKTOK_COOKIES_FILE=cookies.txt
# TIKTOK_COOKIES_FROM_BROWSER=firefox

# Optional: refresh cookies.txt from the browser before each scheduler cycle
# Requires TIKTOK_COOKIES_FROM_BROWSER to be set and the browser to be open.
# TIKTOK_REFRESH_COOKIES=true

# Optional: cache channel listings for N seconds to avoid re-listing every run (default 21600 = 6h)
# LIST_CACHE_TTL=21600

# Optional: pause between channels in the same cycle (seconds) to spread request bursts
# SLEEP_BETWEEN_CHANNELS=30

# Optional: slow down yt-dlp requests (in seconds) to avoid 429/403 rate limits
# Suggested safe defaults when using a real account's cookies:
# YT_DLP_SLEEP_REQUESTS=10
# YT_DLP_SLEEP_INTERVAL=20
# YT_DLP_MAX_SLEEP_INTERVAL=40
