# copy to .env and adjust
DOWNLOAD_BASE_DIR=downloads
STATE_DB_PATH=data/state.db
MIN_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO

# Optional: pass cookies or a logged-in browser profile to yt-dlp to reduce rate limits
# TIKTOK_COOKIES_FILE=cookies.txt
# TIKTOK_COOKIES_FROM_BROWSER=firefox

# Optional: slow down yt-dlp requests (in seconds) to avoid 429 rate limits
# Suggested safe defaults when using a real account's cookies:
# YT_DLP_SLEEP_REQUESTS=2
# YT_DLP_SLEEP_INTERVAL=10
# YT_DLP_MAX_SLEEP_INTERVAL=20
